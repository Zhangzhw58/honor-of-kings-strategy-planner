{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hok/schemas/model-manifest.schema.json",
  "title": "On-device Model Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "version",
    "task",
    "artifact",
    "runtime",
    "input",
    "outputs",
    "training",
    "evaluation",
    "compatibility",
    "release_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "task": { "enum": ["minimap_detection", "time_character_classification"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "format", "sha256", "quantization"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "format": { "const": "tflite" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "quantization": { "enum": ["int8", "float16", "float32"] }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "minimum_version"],
      "properties": {
        "name": { "const": "litert" },
        "minimum_version": { "type": "string", "minLength": 1 }
      }
    },
    "input": { "$ref": "#/$defs/tensor" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tensor" }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "version", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_version", "git_commit"],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "calibration"],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "calibration": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_app_version", "layout_profiles"],
      "properties": {
        "minimum_app_version": { "type": "string", "minLength": 1 },
        "layout_profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "release_status": { "enum": ["candidate", "released", "retired"] }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "enum": ["uint8", "int8", "float32"] },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "color_space": { "enum": ["RGB", "GRAYSCALE"] },
        "normalization": { "type": "string", "minLength": 1 },
        "quantization_scale": { "type": "number", "exclusiveMinimum": 0 },
        "quantization_zero_point": { "type": "integer" }
      }
    }
  }
}
