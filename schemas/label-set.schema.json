{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hok/schemas/label-set.schema.json",
  "title": "Model Label Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "label_set_id", "version", "background_id", "labels"],
  "properties": {
    "schema_version": { "const": 1 },
    "label_set_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "background_id": { "const": 0 },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
